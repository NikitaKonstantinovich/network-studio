string(TIMESTAMP stamp "%Y%m%d_%H%M%S")
set(WORK "${WORK}/${stamp}")
file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${FIXTURES}" --fixtures "${WORK}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot generate field fixtures")
endif()
foreach(case four_sources_0 four_sources_1 four_sources_2 mixed_astro large_stdp)
    execute_process(COMMAND "${GUI}" --field-smoke "${WORK}/${case}" "${WORK}/${case}.json" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Field Win32/DX11 render failed: ${case}")
    endif()
    file(READ "${WORK}/${case}/renderer.txt" report)
    if(NOT report MATCHES "weight_field=1" OR NOT report MATCHES "geometry_builds=1")
        message(FATAL_ERROR "No cached field rendered: ${case}")
    endif()
    message(STATUS "${case}: ${report}")
endforeach()
message(STATUS "PASS: 5 real Win32/DX11 field renders; small fixed scale 0.08, large 0.002 then 0.08 saturation check; font scales 1/1.5: ${WORK}")
