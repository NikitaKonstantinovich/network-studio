# Each execute_process starts and joins a NEW process; no state shared in memory.
file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${FIXTURES}" --fixtures "${WORK}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot generate checkpoint fixtures")
endif()
function(run)
    execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(APPEND "${WORK}/processes.log" "${ARGN}\n${output}${error}\n")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "CLI failed: ${error}")
    endif()
endfunction()
foreach(case RANGE 0 4)
    set(base "${WORK}/case${case}")
    run(--config "${base}.json" --checkpoint "${base}-full.nscp" --output "${base}-full")
    run(--config "${base}.json" --stop-at 0.012013 --checkpoint "${base}-состояние.nscp" --output "${base}-part")
    run(--resume "${base}-состояние.nscp" --run-for 0.010013 --checkpoint "${base}-part2.nscp" --output "${base}-part2")
    run(--resume "${base}-part2.nscp" --checkpoint "${base}-resumed.nscp" --output "${base}-resumed")
    foreach(suffix .nscp _trace.csv _weights.csv _events.csv _summary.json _experiment.json)
        file(SHA256 "${base}-full${suffix}" first)
        file(SHA256 "${base}-resumed${suffix}" second)
        if(NOT first STREQUAL second)
            message(FATAL_ERROR "Restart mismatch: case ${case}, ${suffix}")
        endif()
    endforeach()
endforeach()
foreach(arguments "--dt;0.0000125" "--duration;0.05" "--stop-at;0.001" "--run-for;-1" "--until;0.01")
    execute_process(COMMAND "${CLI}" --resume "${WORK}/case0-full.nscp" ${arguments}
        RESULT_VARIABLE invalid OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(invalid EQUAL 0)
        message(FATAL_ERROR "CLI accepted incompatible resume options: ${arguments}")
    endif()
endforeach()
