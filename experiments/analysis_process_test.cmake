file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${FIXTURES}" --fixtures "${WORK}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Analysis fixture failed")
endif()
execute_process(COMMAND "${CLI}" --analyze-export "${WORK}/source" --analysis-profile "${WORK}/profile.json" --analysis-from .02 --analysis-to .15 --output "${WORK}/process" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Offline analysis process failed")
endif()
foreach(suffix _analysis.json _analysis.txt _activity.csv _bursts.csv _responses.csv)
    file(SHA256 "${WORK}/expected${suffix}" a)
    file(SHA256 "${WORK}/process${suffix}" b)
    if(NOT a STREQUAL b)
        message(FATAL_ERROR "Process export differs: ${suffix}")
    endif()
endforeach()
execute_process(COMMAND "${CLI}" --compare-analysis "${WORK}/expected_analysis.json" "${WORK}/process_analysis.json" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Matching analysis comparison failed")
endif()
execute_process(COMMAND "${CLI}" --analyze-export "${WORK}/source" --analysis-profile "${WORK}/profile.json" --analysis-from .02 --analysis-to .3 --output "${WORK}/partial" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Partial analysis process failed")
endif()
execute_process(COMMAND "${CLI}" --compare-analysis "${WORK}/partial_analysis.json" "${WORK}/partial_analysis.json" RESULT_VARIABLE result)
if(NOT result EQUAL 2)
    message(FATAL_ERROR "Incomplete interval must not pass comparison even with itself")
endif()
