file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${FIXTURES}" --fixtures "${WORK}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Stage fixtures failed")
endif()
foreach(mode continuous split)
  set(extra)
  if(mode STREQUAL split)
    set(extra --stop-at .027)
  endif()
  execute_process(COMMAND "${CLI}" --config "${WORK}/stages.json" --sequence 0 ${extra}
    --checkpoint "${WORK}/${mode}.nscp" --output "${WORK}/${mode}" RESULT_VARIABLE result OUTPUT_QUIET)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Stage ${mode} process failed")
  endif()
endforeach()
execute_process(COMMAND "${CLI}" --resume "${WORK}/split.nscp" --checkpoint "${WORK}/resumed.nscp"
  --output "${WORK}/resumed" RESULT_VARIABLE result OUTPUT_QUIET)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Stage resume process failed")
endif()
foreach(suffix .nscp _trace.csv _weights.csv _events.csv _deliveries.csv _pending_deliveries.csv _stimuli.csv _protocols.json _activity.csv _bursts.csv _responses.csv _analysis.txt _experiment.json _summary.json)
  file(SHA256 "${WORK}/continuous${suffix}" a)
  file(SHA256 "${WORK}/resumed${suffix}" b)
  if(NOT a STREQUAL b)
    message(FATAL_ERROR "Stage cross-process mismatch: ${suffix}")
  endif()
endforeach()
message(STATUS "Stage resume: checkpoint and all trajectory/event/analysis exports match exactly")
