string(TIMESTAMP stamp "%Y%m%d_%H%M%S")
set(run "${WORK}/${stamp}")
execute_process(COMMAND "${GUI}" --analysis-smoke "${run}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Native analysis smoke failed: ${run}")
endif()
file(GLOB captures "${run}/analysis_*.png")
if(NOT captures OR NOT EXISTS "${run}/renderer.txt")
    message(FATAL_ERROR "Missing Win32/DX11 analysis capture: ${run}")
endif()
message(STATUS "Native analysis profile/interval capture: ${run}")
