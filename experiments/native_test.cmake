string(TIMESTAMP stamp "%Y%m%d_%H%M%S")
set(dir "${WORK}/${stamp}")
file(MAKE_DIRECTORY "${dir}")
execute_process(COMMAND "${FIXTURES}" --fixtures "${dir}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Native stage fixtures failed")
endif()
execute_process(COMMAND "${GUI}" --experiment-smoke "${dir}/gui" --config "${dir}/stages.json" RESULT_VARIABLE result TIMEOUT 180)
if(NOT result EQUAL 0 OR NOT EXISTS "${dir}/gui/tab_7.png" OR NOT EXISTS "${dir}/gui/stages_1.png" OR NOT EXISTS "${dir}/gui/generator_1.png")
  message(FATAL_ERROR "Native stage/generator/analysis GUI failed: ${dir}")
endif()
message(STATUS "Win32/DX11 experiment screenshots: ${dir}/gui")
