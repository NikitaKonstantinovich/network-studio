string(TIMESTAMP stamp "%Y%m%d_%H%M%S")
set(run "${WORK}/${stamp}")
execute_process(COMMAND "${GUI}" --weights-smoke "${run}" RESULT_VARIABLE result)
file(GLOB panels "${run}/weights_*.png")
if(NOT result EQUAL 0 OR NOT panels OR NOT EXISTS "${run}/weights_statistics.json")
    message(FATAL_ERROR "Weights Win32/DX11 check failed: ${run}")
endif()
file(READ "${run}/renderer.txt" renderer)
if(NOT renderer MATCHES "weights_win32_dx11=1")
    message(FATAL_ERROR "Weights native panel not exercised")
endif()
message(STATUS "Weights Win32/DX11: ${run}")
