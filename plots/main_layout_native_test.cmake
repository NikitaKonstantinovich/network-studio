string(TIMESTAMP stamp "%Y%m%d_%H%M%S")
string(RANDOM LENGTH 6 ALPHABET 0123456789abcdef suffix)
set(WORK "${WORK}/${stamp}_${suffix}")
file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${GUI}" --layout-smoke "${WORK}" RESULT_VARIABLE result TIMEOUT 45)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Main layout Win32/DX11 check failed: ${result}; see ${WORK}")
endif()
file(READ "${WORK}/renderer.txt" report)
if(NOT report MATCHES "main_layout_win32_dx11=1" OR NOT report MATCHES "layout_scenarios=7")
    message(FATAL_ERROR "Missing native layout coverage: ${WORK}")
endif()
message(STATUS "PASS: 7 real Win32/DX11 layouts, native resize 800x600 to 1920x1080, collapsed plots and font scale 1.5: ${WORK}")
