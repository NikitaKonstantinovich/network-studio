if(NOT DEFINED GUI OR NOT DEFINED WORK)
    message(FATAL_ERROR "GUI and WORK are required")
endif()
string(TIMESTAMP STAMP "%Y%m%d_%H%M%S")
set(OUTPUT "${WORK}/${STAMP}")
execute_process(COMMAND "${GUI}" --viewport-smoke "${OUTPUT}/first" RESULT_VARIABLE FIRST TIMEOUT 60)
if(NOT FIRST EQUAL 0)
    file(READ "${OUTPUT}/first/error.txt" DETAILS)
    message(FATAL_ERROR "Win32/DX11 viewport smoke: ${DETAILS}")
endif()
execute_process(COMMAND "${GUI}" --viewport-smoke "${OUTPUT}/restart" --workspace "${OUTPUT}/first/plots.nsworkspace" RESULT_VARIABLE SECOND TIMEOUT 60)
if(NOT SECOND EQUAL 0)
    file(READ "${OUTPUT}/restart/error.txt" DETAILS)
    message(FATAL_ERROR "Workspace in a new process: ${DETAILS}")
endif()
message(STATUS "Native HWND/DX11 and workspace restart passed: ${OUTPUT}")
