string(TIMESTAMP stamp "%Y%m%d_%H%M%S")
set(dir "${WORK}/${stamp}")
foreach(mode create resume)
  execute_process(COMMAND "${TEST}" "--${mode}" "${dir}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Frequency command checkpoint ${mode} failed")
  endif()
endforeach()
message(STATUS "Pending frequency command: new-process checkpoint and history match exactly: ${dir}")
