file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${FIXTURES}" --fixtures "${WORK}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Shared-source fixtures failed")
endif()
foreach(mode continuous split)
  set(extra)
  if(mode STREQUAL split)
    set(extra --stop-at .0075)
  endif()
  execute_process(COMMAND "${CLI}" --config "${WORK}/spatial.json" --stimulus-commands "${WORK}/moves.json" ${extra}
    --checkpoint "${WORK}/${mode}.nscp" --output "${WORK}/${mode}" RESULT_VARIABLE result OUTPUT_QUIET)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Shared-source ${mode} process failed")
  endif()
endforeach()
execute_process(COMMAND "${CLI}" --resume "${WORK}/split.nscp" --checkpoint "${WORK}/resumed.nscp"
  --output "${WORK}/resumed" RESULT_VARIABLE result OUTPUT_QUIET)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Shared-source resume process failed")
endif()
foreach(suffix .nscp _trace.csv _weights.csv _events.csv _deliveries.csv _pending_deliveries.csv _stimuli.csv _shared_stimuli.csv _stimulator_commands.json _protocols.json _activity.csv _bursts.csv _responses.csv _analysis.txt _experiment.json _summary.json)
  file(SHA256 "${WORK}/continuous${suffix}" a)
  file(SHA256 "${WORK}/resumed${suffix}" b)
  if(NOT a STREQUAL b)
    message(FATAL_ERROR "Shared-source cross-process mismatch: ${suffix}")
  endif()
endforeach()
message(STATUS "Shared-source resume: checkpoint and all exports match byte-for-byte")
