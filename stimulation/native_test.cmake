string(TIMESTAMP stamp "%Y%m%d_%H%M%S")
set(dir "${WORK}/${stamp}")
file(MAKE_DIRECTORY "${dir}")
execute_process(COMMAND "${FIXTURES}" --fixtures "${dir}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Stimulator fixtures failed")
endif()
foreach(example shared spatial)
  execute_process(COMMAND "${GUI}" --stimulator-smoke "${dir}/${example}" --config "${dir}/${example}.json" RESULT_VARIABLE result TIMEOUT 180)
  if(NOT result EQUAL 0 OR NOT EXISTS "${dir}/${example}/tab_0.png" OR NOT EXISTS "${dir}/${example}/stimulators_1.png")
    message(FATAL_ERROR "Native shared-source GUI failed: ${dir}/${example}")
  endif()
  file(READ "${dir}/${example}/renderer.txt" log)
  if(NOT log MATCHES "shared_sources=1" OR NOT log MATCHES "error=\n")
    message(FATAL_ERROR "Native shared-source renderer checks failed: ${log}")
  endif()
endforeach()
message(STATUS "Win32/DX11 shared/spatial/combined-field screenshots: ${dir}")
