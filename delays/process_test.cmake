# Independent executable invocations, including a nonempty queue at the pause.
file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${FIXTURES}" --fixtures "${WORK}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot generate delay fixtures")
endif()
function(run)
    execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(APPEND "${WORK}/processes.log" "${ARGN}\n${output}${error}\n")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "CLI failed: ${error}")
    endif()
endfunction()
foreach(case RANGE 0 7)
    set(base "${WORK}/case${case}")
    run(--config "${base}.json" --checkpoint "${base}-full.nscp" --output "${base}-full")
    run(--config "${base}.json" --stop-at 0.012013 --checkpoint "${base}-очередь.nscp" --output "${base}-part")
    file(STRINGS "${base}-part_pending_deliveries.csv" pending)
    list(LENGTH pending count)
    if(count LESS 2)
        message(FATAL_ERROR "Case ${case}: queue is empty at restart")
    endif()
    run(--resume "${base}-очередь.nscp" --run-for 0.010013 --checkpoint "${base}-part2.nscp" --output "${base}-part2")
    run(--resume "${base}-part2.nscp" --checkpoint "${base}-resumed.nscp" --output "${base}-resumed")
    foreach(suffix .nscp _trace.csv _weights.csv _events.csv _deliveries.csv _pending_deliveries.csv _summary.json _experiment.json)
        file(SHA256 "${base}-full${suffix}" first)
        file(SHA256 "${base}-resumed${suffix}" second)
        if(NOT first STREQUAL second)
            message(FATAL_ERROR "Delayed restart mismatch: case ${case}, ${suffix}")
        endif()
    endforeach()
endforeach()
message(STATUS "PASS: 8 delayed scenarios, 32 processes; snapshots and all 56 exports byte-identical")
