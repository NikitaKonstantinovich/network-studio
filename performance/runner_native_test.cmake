if(NOT DEFINED GUI OR NOT DEFINED WORK)
    message(FATAL_ERROR "GUI and WORK are required")
endif()
file(MAKE_DIRECTORY "${WORK}")
# Only these two test-owned outputs are replaced; no configuration/result tree is removed.
file(REMOVE "${WORK}/close_result.json" "${WORK}/error.txt")
execute_process(COMMAND "${GUI}" --runner-close-smoke "${WORK}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
file(WRITE "${WORK}/process.txt" "result=${result}\nstdout=${output}\nstderr=${error}\n")
if(EXISTS "${WORK}/error.txt")
    file(READ "${WORK}/error.txt" reason)
    message(FATAL_ERROR "Native runner close failed: ${reason}")
endif()
if(NOT result STREQUAL "0" OR NOT EXISTS "${WORK}/close_result.json")
    message(FATAL_ERROR "Native runner close timed out/failed before joined result: ${result}; ${error}")
endif()
file(READ "${WORK}/close_result.json" report)
foreach(field active_before_close wm_close_posted joined resources_released)
    string(JSON value GET "${report}" "${field}")
    if(NOT value)
        message(FATAL_ERROR "Native close did not confirm ${field}")
    endif()
endforeach()
string(JSON steps GET "${report}" steps_before_close)
if(steps LESS 1)
    message(FATAL_ERROR "Native close fixture never computed a step")
endif()
message(STATUS "Native WM_CLOSE while computing: worker joined and resources released after ${steps} steps")
