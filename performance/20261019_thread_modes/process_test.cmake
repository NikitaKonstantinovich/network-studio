string(TIMESTAMP stamp "%Y%m%d_%H%M%S")
set(WORK "${WORK}/${stamp}")
file(MAKE_DIRECTORY "${WORK}")
function(run name)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
    file(WRITE "${WORK}/${name}.log" "result=${result}\n${output}\n${error}")
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "${name} failed: ${result}; ${output}; ${error}")
    endif()
endfunction()
run(fixture "${FIXTURES}" --write-fixture "${WORK}/fixture.json")
run(serial "${CLI}" --config "${WORK}/fixture.json" --threads 1 --checkpoint "${WORK}/serial.nscp" --output "${WORK}/serial")
run(prefix6 "${CLI}" --config "${WORK}/fixture.json" --threads 6 --stop-at .0013 --checkpoint "${WORK}/prefix.nscp" --output "${WORK}/prefix")
run(resume12 "${CLI}" --resume "${WORK}/prefix.nscp" --threads 12 --stop-at .0021 --checkpoint "${WORK}/middle.nscp" --output "${WORK}/middle")
run(resume16 "${CLI}" --resume "${WORK}/middle.nscp" --threads 16 --checkpoint "${WORK}/resumed.nscp" --output "${WORK}/resumed")
file(GLOB files "${WORK}/serial_*.csv")
list(APPEND files "${WORK}/serial.nscp")
foreach(reference IN LISTS files)
    string(REPLACE "/serial" "/resumed" actual "${reference}")
    file(SHA256 "${reference}" expected)
    file(SHA256 "${actual}" got)
    if(NOT expected STREQUAL got)
        message(FATAL_ERROR "Cross-process 6 -> 12 -> 16 changed ${reference}")
    endif()
endforeach()
list(LENGTH files count)
message(STATUS "Separate CLI processes 6 -> 12 -> 16: ${count} complete files exactly match continuous serial; ${WORK}")
