string(TIMESTAMP stamp "%Y%m%d_%H%M%S")
set(WORK "${WORK}/${stamp}")
file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${GUI}" --runner-close-smoke "${WORK}" --compute-threads "${COUNT}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 40)
file(WRITE "${WORK}/process.txt" "result=${result}\nstdout=${output}\nstderr=${error}\n")
if(NOT result STREQUAL "0" OR EXISTS "${WORK}/error.txt" OR NOT EXISTS "${WORK}/close_result.json")
    message(FATAL_ERROR "Native ${COUNT}-thread lifecycle failed; see ${WORK}")
endif()
file(READ "${WORK}/close_result.json" report)
foreach(field active_before_close wm_close_posted joined resources_released)
    string(JSON value GET "${report}" "${field}")
    if(NOT value)
        message(FATAL_ERROR "Native close did not confirm ${field}")
    endif()
endforeach()
foreach(field compute_threads effective_compute_threads)
    string(JSON value GET "${report}" "${field}")
    if(NOT value EQUAL COUNT)
        message(FATAL_ERROR "Native close used ${field}=${value}, expected ${COUNT}")
    endif()
endforeach()
string(JSON steps GET "${report}" steps_before_close)
if(steps LESS 1)
    message(FATAL_ERROR "Native close fixture never computed a step")
endif()
message(STATUS "Native Win32/DX11: ${COUNT} compute threads; close while running after ${steps} steps; all threads joined")
