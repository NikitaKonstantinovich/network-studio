if(NOT DEFINED GUI OR NOT DEFINED WORK)
    message(FATAL_ERROR "GUI and WORK are required")
endif()
file(MAKE_DIRECTORY "${WORK}")
# Replace only the outputs owned by this native lifecycle check.
file(REMOVE "${WORK}/close_result.json" "${WORK}/error.txt")
execute_process(COMMAND "${GUI}" --runner-close-smoke "${WORK}" --compute-threads 4
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 40)
file(WRITE "${WORK}/process.txt" "result=${result}\nstdout=${output}\nstderr=${error}\n")
if(EXISTS "${WORK}/error.txt")
    file(READ "${WORK}/error.txt" reason)
    message(FATAL_ERROR "Native parallel close failed: ${reason}")
endif()
if(NOT result STREQUAL "0" OR NOT EXISTS "${WORK}/close_result.json")
    message(FATAL_ERROR "Native parallel close timed out/failed before joined result: ${result}; ${error}")
endif()
file(READ "${WORK}/close_result.json" report)
foreach(field active_before_close wm_close_posted joined resources_released)
    string(JSON value GET "${report}" "${field}")
    if(NOT value)
        message(FATAL_ERROR "Native parallel close did not confirm ${field}")
    endif()
endforeach()
foreach(field compute_threads effective_compute_threads)
    string(JSON value GET "${report}" "${field}")
    if(NOT value EQUAL 4)
        message(FATAL_ERROR "Native parallel close used ${field}=${value}, expected 4")
    endif()
endforeach()
string(JSON neurons GET "${report}" neurons)
string(JSON synapses GET "${report}" synapses)
if(NOT neurons EQUAL 128 OR NOT synapses EQUAL 4096)
    message(FATAL_ERROR "Unexpected native parallel close fixture: ${neurons} neurons, ${synapses} synapses")
endif()
string(JSON steps GET "${report}" steps_before_close)
if(steps LESS 1)
    message(FATAL_ERROR "Native parallel close fixture never computed a step")
endif()
message(STATUS "Native WM_CLOSE while computing: controller and 3 helpers joined after ${steps} steps; resources released")
