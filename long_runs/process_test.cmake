string(TIMESTAMP stamp "%Y%m%d_%H%M%S")
set(WORK "${WORK}/${stamp}")
file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${FIXTURES}" --fixtures "${WORK}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot create long-run fixture")
endif()
function(run)
    execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(APPEND "${WORK}/processes.log" "${ARGN}\n${output}${error}\n")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "CLI failed: ${error}")
    endif()
endfunction()
run(--config "${WORK}/long.json" --checkpoint "${WORK}/full.nscp" --output "${WORK}/full")
run(--config "${WORK}/long.json" --stop-at 130 --checkpoint "${WORK}/part.nscp" --output "${WORK}/part")
run(--resume "${WORK}/part.nscp" --checkpoint "${WORK}/resumed.nscp" --output "${WORK}/resumed")
foreach(suffix .nscp _trace.csv _weights.csv _events.csv _deliveries.csv _pending_deliveries.csv _summary.json _experiment.json)
    file(SHA256 "${WORK}/full${suffix}" first)
    file(SHA256 "${WORK}/resumed${suffix}" second)
    if(NOT first STREQUAL second)
        message(FATAL_ERROR "Long-run restart mismatch: ${suffix}")
    endif()
endforeach()
message(STATUS "PASS: 200 s, stimulation after 150 s, restart at 130 s; checkpoint and all exports byte-identical. ${WORK}")
