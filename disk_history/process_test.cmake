string(TIMESTAMP stamp "%Y%m%d_%H%M%S")
set(run "${WORK}/${stamp}")
file(MAKE_DIRECTORY "${run}")
function(run_checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
    file(APPEND "${run}/process.log" "${ARGV}\n${out}${err}\n")
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Archive process test failed (${status}): ${out} ${err}; ${run}")
    endif()
endfunction()
run_checked("${TEST}" --fixtures "${run}")
run_checked("${CLI}" --config "${run}/fixture.json" --archive "${run}/continuous" --archive-rows 32 --archive-deliveries yes --checkpoint "${run}/continuous.nscp" --output "${run}/continuous_ram")
run_checked("${CLI}" --config "${run}/fixture.json" --archive "${run}/continued" --archive-rows 32 --archive-deliveries yes --stop-at .100025 --checkpoint "${run}/pause.nscp" --output "${run}/pause_ram")
run_checked("${CLI}" --resume "${run}/pause.nscp" --archive-append "${run}/continued" --archive-deliveries yes --stop-at .200025 --checkpoint "${run}/pause2.nscp" --output "${run}/pause2_ram")
run_checked("${CLI}" --resume "${run}/pause2.nscp" --archive-append "${run}/continued" --archive-deliveries yes --checkpoint "${run}/resumed.nscp" --output "${run}/resumed_ram")
run_checked("${TEST}" --compare "${run}/continuous.nscp" "${run}/resumed.nscp" "${run}")
foreach(name continuous continued)
    run_checked("${CLI}" --export-archive "${run}/${name}" --analysis-from 0 --analysis-to .31 --output "${run}/${name}_disk")
    run_checked("${CLI}" --analyze-archive "${run}/${name}" --analysis-profile "${run}/profile.json" --analysis-from 0 --analysis-to .3 --output "${run}/${name}_analysis")
endforeach()
foreach(channel states events deliveries stimuli shared_updates)
    run_checked("${CMAKE_COMMAND}" -E compare_files "${run}/continuous_disk_${channel}.csv" "${run}/continued_disk_${channel}.csv")
endforeach()
foreach(channel activity bursts responses analysis)
    if(channel STREQUAL analysis)
        set(extension json)
    else()
        set(extension csv)
    endif()
    run_checked("${CMAKE_COMMAND}" -E compare_files "${run}/continuous_analysis_${channel}.${extension}" "${run}/continued_analysis_${channel}.${extension}")
endforeach()
file(SHA256 "${run}/continued/manifest.nsh" before)
run_checked("${CLI}" --resume "${run}/pause.nscp" --archive "${run}/branch" --archive-deliveries yes --checkpoint "${run}/branch.nscp" --output "${run}/branch_ram")
file(SHA256 "${run}/continued/manifest.nsh" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Branch modified source manifest")
endif()
run_checked("${TEST}" --compare "${run}/continuous.nscp" "${run}/branch.nscp" "${run}")
run_checked("${CLI}" --export-archive "${run}/branch" --analysis-from 0 --analysis-to .31 --output "${run}/branch_disk")
foreach(channel states events deliveries stimuli shared_updates)
    run_checked("${CMAKE_COMMAND}" -E compare_files "${run}/continuous_disk_${channel}.csv" "${run}/branch_disk_${channel}.csv")
endforeach()
file(STRINGS "${run}/branch_disk_protocols.jsonl" protocol_lines)
foreach(line IN LISTS protocol_lines)
    string(JSON type TYPE "${line}")
    if(NOT type STREQUAL "OBJECT")
        message(FATAL_ERROR "Protocol export is not valid JSONL")
    endif()
endforeach()
run_checked("${CLI}" --resume "${run}/continuous.nscp" --archive-append "${run}/continuous" --archive-deliveries yes --until .350025 --checkpoint "${run}/extended.nscp" --output "${run}/extended_ram")
run_checked("${CLI}" --config "${run}/fixture.json" --duration .350025 --archive "${run}/extended_reference" --archive-rows 32 --archive-deliveries yes --checkpoint "${run}/extended_reference.nscp" --output "${run}/extended_reference_ram")
run_checked("${TEST}" --compare "${run}/extended_reference.nscp" "${run}/extended.nscp" "${run}")
message(STATUS "Archive process continuation and branch verified: ${run}")
