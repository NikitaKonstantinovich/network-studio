string(TIMESTAMP stamp "%Y%m%d_%H%M%S")
set(run "${WORK}/${stamp}")
execute_process(COMMAND "${GUI}" --archive-smoke "${run}" RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR NOT EXISTS "${run}/disk_analysis_analysis.json" OR NOT EXISTS "${run}/tab_5.png")
    message(FATAL_ERROR "Native archive GUI check failed: ${run}")
endif()
file(GLOB panels "${run}/archive_*.png")
if(NOT panels)
    message(FATAL_ERROR "Missing native archive panel capture: ${run}")
endif()
file(READ "${run}/renderer.txt" renderer)
if(NOT renderer MATCHES "archive_win32_dx11=1")
    message(FATAL_ERROR "Archive native panel not exercised")
endif()
message(STATUS "Archive recording and analysis rendered by Win32/DX11: ${run}")
